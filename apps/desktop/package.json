{
  "name": "deepreader-desktop",
  "version": "0.0.1",
  "description": "A local-first deep reading coach for serious readers.",
  "author": "pseudoctor <github@solo-digitalpass.eu.org>",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "icon:mac": "node scripts/build-icon.mjs",
    "runtime:python": "node scripts/prepare-python-runtime.mjs",
    "runtime:python:win": "node scripts/prepare-python-runtime-win.mjs",
    "signing:check": "node scripts/check-mac-signing-env.mjs",
    "dev": "npm run build && node scripts/launch-dev.mjs",
    "start": "npm run build && electron dist/main.js",
    "package:mac": "npm run icon:mac && npm run runtime:python && electron-builder --mac --dir",
    "dist:mac": "npm run icon:mac && npm run runtime:python && electron-builder --mac",
    "package:win": "npm run runtime:python:win && electron-builder --win --dir",
    "dist:win": "npm run runtime:python:win && electron-builder --win"
  },
  "build": {
    "appId": "org.pseudoctor.deep-reading",
    "productName": "Deepreader",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": "../../scripts",
        "to": "scripts"
      },
      {
        "from": ".runtime/python",
        "to": "python"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "dmg": {
      "title": "Deepreader ${version}",
      "backgroundColor": "#f3f1eb",
      "window": {
        "width": 560,
        "height": 360
      },
      "contents": [
        {
          "x": 180,
          "y": 170,
          "type": "file"
        },
        {
          "x": 390,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.2",
    "typescript": "^5.9.0"
  }
}
